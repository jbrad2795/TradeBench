{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "echo 'static - nothing to build'",
  "installCommand": "echo 'no dependencies'",
  "outputDirectory": ".",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/data/(.*)",
      "headers": [{ "key": "cache-control", "value": "public, max-age=300, must-revalidate" }]
    }
  ]
}
